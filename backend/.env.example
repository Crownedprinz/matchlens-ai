AGENT_MODE=mock
FOUNDRY_PUBLIC_ENABLED=false
FOUNDRY_PUBLIC_ACCESS_GUID=
FOUNDRY_PUBLIC_MATCH_IDS=match-001
FOUNDRY_CREDENTIAL_MODE=azure_cli
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_INVESTIGATOR_NAME=matchlens-investigator
FOUNDRY_INVESTIGATOR_VERSION=1.0
FOUNDRY_PREDICTOR_NAME=matchlens-predictor
FOUNDRY_PREDICTOR_VERSION=1.0
FOUNDRY_INSIGHT_NAME=matchlens-insight
FOUNDRY_INSIGHT_VERSION=1.0
FOUNDRY_MODEL=gpt-5-mini
FOUNDRY_TIMEOUT_SECONDS=60
FOUNDRY_END_TO_END_TIMEOUT_SECONDS=120
FOUNDRY_VALIDATION_RETRIES=0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ANALYSIS_RATE_LIMIT_PER_MINUTE=12
